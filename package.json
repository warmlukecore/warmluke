{
  "name": "adaptive-os",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Adaptive Business OS — schema-driven business app platform prototype",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "NODE_ENV=production next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "audit": "pnpm audit --audit-level=high",
    "check": "node scripts/run-checks.mjs",
    "check:pure": "node scripts/run-checks.mjs --tier pure",
    "check:live": "node scripts/run-checks.mjs --tier live",
    "check:list": "node scripts/run-checks.mjs --list",
    "hooks": "git config core.hooksPath scripts/hooks"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.61",
    "@ai-sdk/google": "^4.0.78",
    "@supabase/supabase-js": "^2.116.0",
    "ai": "^7.0.112",
    "cobe": "2.0.1",
    "lucide-react": "^1.47.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
