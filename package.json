{
  "name": "adaptive-os",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Adaptive Business OS — schema-driven business app platform prototype",
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:sandbox": "sh scripts/dev-sandbox.sh",
    "build": "node scripts/build-walk-page.mjs && NODE_ENV=production next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts e2e",
    "format": "oxfmt src scripts e2e playwright.config.ts",
    "format:check": "oxfmt --check src scripts e2e playwright.config.ts",
    "audit": "pnpm audit --audit-level=high",
    "check": "node scripts/run-checks.mjs",
    "check:pure": "node scripts/run-checks.mjs --tier pure",
    "check:live": "node scripts/run-checks.mjs --tier live",
    "check:list": "node scripts/run-checks.mjs --list",
    "hooks": "git config core.hooksPath scripts/hooks",
    "walk-page": "node scripts/build-walk-page.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/google": "^4.0.94",
    "@ai-sdk/workflow": "^2.0.70",
    "@supabase/supabase-js": "^2.117.3",
    "@vercel/sandbox": "3.7.0",
    "ai": "^7.0.138",
    "cobe": "2.0.1",
    "lucide-react": "^1.56.0",
    "next": "~16.4.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "remark-breaks": "^4.0.0",
    "streamdown": "2.7.0",
    "workflow": "5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "postcss": "8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
