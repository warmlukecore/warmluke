{
  "name": "adaptive-os",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Adaptive Business OS — schema-driven business app platform prototype",
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:sandbox": "sh scripts/dev-sandbox.sh",
    "build": "NODE_ENV=production next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts e2e",
    "format": "oxfmt src scripts e2e playwright.config.ts",
    "format:check": "oxfmt --check src scripts e2e playwright.config.ts",
    "audit": "pnpm audit --audit-level=high",
    "check": "node scripts/run-checks.mjs",
    "check:pure": "node scripts/run-checks.mjs --tier pure",
    "check:live": "node scripts/run-checks.mjs --tier live",
    "check:list": "node scripts/run-checks.mjs --list",
    "hooks": "git config core.hooksPath scripts/hooks"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.69",
    "@ai-sdk/google": "^4.0.86",
    "@ai-sdk/workflow": "^2.0.54",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/sandbox": "3.5.1",
    "ai": "^7.0.123",
    "cobe": "2.0.1",
    "lucide-react": "^1.49.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-breaks": "^4.0.0",
    "streamdown": "2.6.0",
    "workflow": "5.0.0-beta.57",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
