NEXT_PUBLIC_ADAPTIVE_OS_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_ADAPTIVE_OS_SUPABASE_ANON_KEY=your-anon-key
ADAPTIVE_OS_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-5

# The gap pass reads two short texts and names what is missing — a
# narrower job than designing the app, at a fraction of the price.
ANTHROPIC_GAP_MODEL=claude-haiku-4-5-20251001

# Fallback when the Anthropic balance runs out. Set ANTHROPIC_MODEL to a
# gemini-* id and this key is used instead; the provider follows the model
# name, so there is no second switch to forget.
GEMINI_API_KEY=your-gemini-key

# When Gemini is busy and a retry also fails, this is what gets paid for
# instead of failing the request.
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-5

# Shopify app credentials. Without them the connect routes answer 503
# rather than half-working.
SHOPIFY_CLIENT_ID=your-shopify-app-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-app-client-secret
